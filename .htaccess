# XAMPP convenience: this project lives in htdocs, but only public/ may be
# served. Send every request into public/ (http://localhost/awas-system ->
# http://localhost/awas-system/public/), which also keeps .env, storage/,
# vendor/ etc. from ever being downloadable. If you rename the folder,
# update RewriteBase. On a real server, point the document root at public/
# instead and delete this file.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /awas-system/
    RewriteCond %{REQUEST_URI} !/public/
    RewriteRule ^(.*)$ public/$1 [R=302,L]
</IfModule>

# Belt and braces if mod_rewrite is off: never serve dotfiles (.env) or source.
<FilesMatch "^\.|\.(env|sql|log|md|json|lock|xml)$">
    Require all denied
</FilesMatch>
